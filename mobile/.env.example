EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Single-user personal app: set these to auto sign-in (and self-provision on
# first launch) without ever showing the login screen. Leave unset to fall
# back to the manual email/password form.
EXPO_PUBLIC_OWNER_EMAIL=
EXPO_PUBLIC_OWNER_PASSWORD=
